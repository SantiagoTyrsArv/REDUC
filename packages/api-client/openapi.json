  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/auth/login": {
      "post": {
        "description": "Exchange email and password for an access token (15 min) and a refresh token (7 days).",
        "operationId": "login_v1_admin_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
